# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Required - Database & Auth)
# Get these from your Supabase Dashboard: Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. BRANDING & SITE CONFIGURATION (Optional - Defaults are used if empty)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FlixOn
NEXT_PUBLIC_APP_SHORT_NAME=FlixOn
NEXT_PUBLIC_APP_TAGLINE="World's #1 Video & Movie Streaming Platform"
NEXT_PUBLIC_APP_DESCRIPTION="Stream and download unlimited HD movies and series on any device."

# Currency (UGX, USD, KES, NGN, TZS, GHS, EUR, GBP)
NEXT_PUBLIC_CURRENCY=UGX
NEXT_PUBLIC_CURRENCY_SYMBOL=UGX

# Support & Contacts
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_WHATSAPP=+256700000000
NEXT_PUBLIC_TELEGRAM=@your_support

# ------------------------------------------------------------------------------
# 3. MAINTENANCE & SECURITY
# ------------------------------------------------------------------------------
# Random secret string for Vercel Cron jobs and API protection
CRON_SECRET=change-this-to-a-random-secret-string-12345

# For local development with self-signed SSL certificates (optional)
NODE_TLS_REJECT_UNAUTHORIZED=0
